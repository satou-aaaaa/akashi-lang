fn main(console: Console) -> Unit
do
  print(to: console, value: 7 / 2)
  print(to: console, value: -7 / 2)
  print(to: console, value: -7 % 3)
  print(to: console, value: 7 % -3)
  print(to: console, value: 9007199254740991)
  print(to: console, value: -9007199254740991)
  print(to: console, value: 3000000 * 3000000)
  print(to: console, value: 0 * -5)
  print(to: console, value: -(4 - 10))
end
