{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(fn\\b.*|type\\b.*|.*\\bdo|.*\\bthen|\\s*else|\\s*when|.*\\bmatch\\b.*)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(end|else|do)\\b"
  }
}
